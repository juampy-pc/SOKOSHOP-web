// GENERADO: copia de sokoshop-admin/prisma/schema.prisma (npm run schema:sync).
// NO editar acá ni correr `prisma migrate` / `db push` desde la tienda.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

model Brand {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  origin      String
  logoUrl     String?
  description String?
  products    Product[]
  aliases     BrandAlias[]
  promotions  Promotion[]
  archivedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([name(ops: raw("gin_trgm_ops"))], map: "brand_name_trgm_idx", type: Gin)
}

model Product {
  id               String           @id @default(cuid())
  slug             String           @unique
  brand            Brand            @relation(fields: [brandId], references: [id])
  brandId          String
  name             String
  gender           String?
  concentration    String?
  decantAvailable  Boolean          @default(false)
  notesStructure   String           @default("sin_datos")
  olfactiveFamily  String?
  descriptionShort String?
  descriptionLong  String?
  launchYear       Int?
  perfumer         String?
  status           String           @default("borrador")
  variants         ProductVariant[]
  notes            ProductNote[]
  images           ProductImage[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([brandId])
  @@index([status])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "product_name_trgm_idx", type: Gin)
  @@index([olfactiveFamily(ops: raw("gin_trgm_ops"))], map: "product_family_trgm_idx", type: Gin)
}

model ProductVariant {
  id             String          @id @default(cuid())
  product        Product         @relation(fields: [productId], references: [id])
  productId      String
  type           String
  sizeMl         Float?
  price          Int
  salePrice      Int?
  stock          Int?
  skuInternal    String?         @unique
  gtin           String?
  costInclTax    Int?
  marginPct      Float?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  orderItems     OrderItem[]
  stockMovements StockMovement[]
  purchaseItems  PurchaseItem[]
  priceListItems PriceListItem[]
  giftPromotions Promotion[]     @relation("PromotionGift")
  images         ProductImage[]

  @@index([productId])
}

model Note {
  id       String        @id @default(cuid())
  name     String        @unique
  products ProductNote[]

  @@index([name(ops: raw("gin_trgm_ops"))], map: "note_name_trgm_idx", type: Gin)
}

model ProductNote {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id])
  productId String
  note      Note    @relation(fields: [noteId], references: [id])
  noteId    String
  position  String
  order     Int     @default(0)

  @@unique([productId, noteId, position])
  @@index([noteId])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin")
  createdAt    DateTime @default(now())

  active             Boolean   @default(true)
  // Se incrementa al cambiar contraseña/rol/2FA o desactivar: invalida sesiones abiertas.
  sessionVersion     Int       @default(0)
  totpSecretEnc      String?
  totpEnabled        Boolean   @default(false)
  totpLastStep       Int?
  recoveryCodeHashes String[]  @default([])
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime?
  updatedAt          DateTime  @default(now()) @updatedAt

  auditLogs       AuditLog[]
  stockMovements  StockMovement[]
  importBatches   ImportBatch[]
  ordersSold      Order[]             @relation("OrderSeller")
  cashOpened      CashSession[]       @relation("CashOpenedBy")
  cashClosed      CashSession[]       @relation("CashClosedBy")
  cashMovements   CashMovement[]
  accountEntries  AccountEntry[]
  customersAdded  Customer[]          @relation("CustomerCreatedBy")
  orderReturns    OrderReturn[]
  purchasesMade   Purchase[]          @relation("PurchaseCreatedBy")
  purchasesRecv   Purchase[]          @relation("PurchaseReceivedBy")
  withdrawals     WithdrawalRequest[]
  legalEdits      LegalPage[]
  perfumeRequests PerfumeRequest[]
}

model Order {
  id              String              @id @default(cuid())
  // Número correlativo del comprobante (Nota de pedido 1-NNN)
  number          Int                 @unique @default(autoincrement())
  status          String              @default("pendiente")
  channel         String              @default("online") // online (tienda) | local (POS) | mayorista
  paymentMethod   String? // efectivo | transferencia | debito | credito | mercadopago | mixto
  subtotal        Int?
  discount        Int                 @default(0)
  total           Int
  customerEmail   String?
  customerName    String?
  mpPreferenceId  String?
  mpPaymentId     String?
  customerPhone   String?
  notes           String?
  paidAt          DateTime?
  seller          AdminUser?          @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  sellerId        String?
  cashSession     CashSession?        @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  cashSessionId   String?
  cashMovements   CashMovement[]
  items           OrderItem[]
  stockMovements  StockMovement[]
  customer        Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId      String?
  accountEntries  AccountEntry[]
  // Preparación/entrega: pendiente_preparar | preparado | pendiente_entrega | retiro_sucursal | entregado
  fulfillment     String              @default("pendiente_preparar")
  fulfilledAt     DateTime?
  // Identificador generado por el POS: evita duplicar ventas al reintentar o sincronizar sin conexión.
  clientRef       String?             @unique
  offline         Boolean             @default(false)
  // Devoluciones: monto reintegrado acumulado (los reportes usan total - refundedAmount)
  refundedAmount  Int                 @default(0)
  cancelledAt     DateTime?
  returns         OrderReturn[]
  // Entrega (tienda online): envio | retiro
  deliveryMethod  String?
  shippingZone    ShippingZone?       @relation(fields: [shippingZoneId], references: [id], onDelete: SetNull)
  shippingZoneId  String?
  shippingCost    Int                 @default(0)
  shipAddress     String?
  shipCity        String?
  shipProvince    String?
  shipZip         String?
  shipNotes       String?
  trackingCarrier String?
  trackingCode    String?
  trackingUrl     String?
  // Promoción o cupón aplicado
  promotion       Promotion?          @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  promotionId     String?
  couponCode      String?
  // Lista de precios usada (ventas mayoristas)
  priceList       PriceList?          @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  priceListId     String?
  // Venta con seña (a pedido): se cobra una parte al vender y el saldo al entregar.
  deposit         Int?
  balanceDue      Int                 @default(0)
  notifications   Notification[]
  withdrawals     WithdrawalRequest[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([mpPaymentId])
  @@index([channel, createdAt])
  @@index([customerId])
  @@index([sellerId, createdAt])
  @@index([channel, fulfillment])
  @@index([balanceDue])
}

model OrderItem {
  id               String         @id @default(cuid())
  order            Order          @relation(fields: [orderId], references: [id])
  orderId          String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  productVariantId String
  productName      String
  variantLabel     String
  price            Int
  quantity         Int
  returnedQty      Int            @default(0)
  isGift           Boolean        @default(false) // regalo de una promoción (precio 0)

  @@index([orderId])
  @@index([productVariantId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

model AuditLog {
  id         String     @id @default(cuid())
  actor      AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?
  actorEmail String?
  action     String
  entity     String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime   @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

// Todo cambio de stock queda registrado. quantity con signo (+ingreso / -venta).
model StockMovement {
  id         String         @id @default(cuid())
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  variantId  String
  type       String // venta_online | venta_local | venta_mayorista | ajuste | ingreso | devolucion
  quantity   Int
  stockAfter Int?
  order      Order?         @relation(fields: [orderId], references: [id])
  orderId    String?
  // Devolución o compra que originó el movimiento (orderId queda vacío para no chocar con la venta)
  return     OrderReturn?   @relation(fields: [returnId], references: [id], onDelete: SetNull)
  returnId   String?
  purchase   Purchase?      @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  purchaseId String?
  reason     String?
  actor      AdminUser?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?
  createdAt  DateTime       @default(now())

  // Idempotencia: un pedido no genera dos veces el mismo movimiento para una variante.
  @@unique([orderId, variantId, type])
  @@index([variantId, createdAt])
  @@index([type, createdAt])
}

// Redirecciones 301/410 que aplica la tienda (migración desde TiendaNegocio, cambios de slug).
model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String?
  statusCode Int      @default(301)
  active     Boolean  @default(true)
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Importación de catálogo en dos pasos: se carga a un lote en revisión, se corrige y recién ahí se aplica.
model ImportBatch {
  id          String      @id @default(cuid())
  fileName    String
  status      String      @default("revision") // revision | aplicado | descartado
  updateStock Boolean     @default(true)
  createdBy   AdminUser?  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime    @default(now())
  appliedAt   DateTime?
  summary     Json?
  rows        ImportRow[]

  @@index([createdAt])
}

model ImportRow {
  id          String      @id @default(cuid())
  batch       ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchId     String
  rowNumber   Int
  raw         Json
  // Datos normalizados (editables en la revisión)
  code        String?
  name        String
  brandText   String
  brandId     String?
  variantType String
  sizeMl      Float?
  price       Int?
  cost        Int?
  stock       Int?
  // Resultado del cruce con el catálogo
  action      String // actualizar | nuevo_variante | nuevo_producto | sin_cambios | error
  variantId   String?
  productId   String?
  groupKey    String?
  errors      String[]    @default([])
  include     Boolean     @default(true)
  nameEdited  Boolean     @default(false) // solo si se corrigió a mano se renombra el producto

  @@index([batchId, rowNumber])
}

// Cómo se escribe una marca en archivos externos -> marca del catálogo (p. ej. "LATAFFA" -> Lattafa).
model BrandAlias {
  id      String @id @default(cuid())
  alias   String @unique // normalizado: minúsculas, sin espacios ni símbolos
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  brandId String
}

// Caja del local: una sesión abierta a la vez; cada cobro o movimiento queda registrado.
model CashSession {
  id            String         @id @default(cuid())
  openedAt      DateTime       @default(now())
  openedBy      AdminUser?     @relation("CashOpenedBy", fields: [openedById], references: [id], onDelete: SetNull)
  openedById    String?
  openingAmount Int            @default(0)
  closedAt      DateTime?
  closedBy      AdminUser?     @relation("CashClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  closedById    String?
  // Arqueo al cierre: contado y esperado por medio de pago
  countedJson   Json?
  expectedJson  Json?
  notes         String?
  movements     CashMovement[]
  orders        Order[]

  @@index([closedAt])
  @@index([openedAt])
}

model CashMovement {
  id          String      @id @default(cuid())
  session     CashSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId   String
  type        String // venta | ingreso | egreso | retiro
  method      String // efectivo | transferencia | debito | credito | mercadopago
  amount      Int // siempre positivo; el tipo define el signo
  description String?
  order       Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId     String?
  actor       AdminUser?  @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId     String?
  createdAt   DateTime    @default(now())

  @@index([sessionId, createdAt])
  @@index([createdAt])
}

// Estadísticas propias de la tienda (anónimas: sin cookies ni datos personales).
model AnalyticsEvent {
  id        String   @id @default(cuid())
  type      String // view | product_view | search | add_to_cart | checkout_start | purchase
  path      String?
  productId String?
  query     String?
  results   Int?
  value     Int?
  sessionId String?
  referrer  String?
  device    String? // mobile | desktop
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([createdAt])
  @@index([productId, type])
}

// Clientes con cuenta corriente (ventas "fiado" en el local).
model Customer {
  id          String         @id @default(cuid())
  fullName    String
  docType     String // DNI | CUIT
  docNumber   String         @unique
  address     String
  phone       String
  email       String
  birthDate   DateTime       @db.Date
  creditLimit Int            @default(600000)
  active      Boolean        @default(true)
  priceList   PriceList?     @relation(fields: [priceListId], references: [id], onDelete: SetNull)
  priceListId String?
  notes       String?
  createdBy   AdminUser?     @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?
  orders      Order[]
  entries     AccountEntry[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([fullName])
}

// Movimientos de cuenta corriente. amount > 0 aumenta la deuda (cargo), < 0 la reduce (pago).
model AccountEntry {
  id          String     @id @default(cuid())
  customer    Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerId  String
  type        String // cargo | pago | ajuste
  amount      Int
  method      String? // medio del pago (efectivo, transferencia...)
  description String?
  order       Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId     String?
  actor       AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId     String?
  createdAt   DateTime   @default(now())

  @@index([customerId, createdAt])
  @@index([createdAt])
}

// Devoluciones y anulaciones de ventas: reponen stock, reintegran dinero (caja o cuenta corriente).
model OrderReturn {
  id             String          @id @default(cuid())
  order          Order           @relation(fields: [orderId], references: [id])
  orderId        String
  kind           String // devolucion | anulacion
  reason         String
  refundMethod   String // efectivo | transferencia | debito | credito | mercadopago | cuenta_corriente | sin_reintegro
  refundAmount   Int
  restock        Boolean         @default(true)
  items          Json // [{ itemId, variantId, qty, price, name }]
  actor          AdminUser?      @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId        String?
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())

  @@index([orderId])
  @@index([createdAt])
}

model Supplier {
  id          String     @id @default(cuid())
  name        String
  taxId       String?
  contactName String?
  phone       String?
  email       String?
  address     String?
  notes       String?
  active      Boolean    @default(true)
  archivedAt  DateTime?
  purchases   Purchase[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([name])
}

// Compras a proveedores: al recibirlas suben el stock y actualizan costo (y opcionalmente precio).
model Purchase {
  id             String          @id @default(cuid())
  number         Int             @unique @default(autoincrement())
  supplier       Supplier        @relation(fields: [supplierId], references: [id])
  supplierId     String
  invoiceRef     String?
  date           DateTime        @default(now())
  status         String          @default("borrador") // borrador | recibida | anulada
  total          Int             @default(0)
  notes          String?
  paid           Boolean         @default(false)
  paidAt         DateTime?
  paidMethod     String?
  createdBy      AdminUser?      @relation("PurchaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdById    String?
  receivedBy     AdminUser?      @relation("PurchaseReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  receivedById   String?
  receivedAt     DateTime?
  items          PurchaseItem[]
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([supplierId, date])
  @@index([status, date])
}

model PurchaseItem {
  id         String         @id @default(cuid())
  purchase   Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  purchaseId String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  variantId  String
  quantity   Int
  unitCost   Int // costo unitario final (con impuestos)
  updateCost Boolean        @default(true)
  newPrice   Int? // si se carga, al recibir se cambia el precio de venta

  @@index([purchaseId])
  @@index([variantId])
}

// Opciones de entrega de la tienda: zonas de envío a domicilio y puntos de retiro en sucursal.
model ShippingZone {
  id           String    @id @default(cuid())
  kind         String    @default("envio") // envio | retiro
  name         String
  description  String?
  price        Int
  freeFrom     Int? // envío gratis desde este subtotal
  minOrder     Int? // compra mínima para poder elegirla
  etaText      String? // "24 a 48 h hábiles"
  deliveryDays String? // "Lunes, miércoles y viernes de 14 a 20"
  address      String? // retiro: dirección de la sucursal
  hours        String? // retiro: horarios
  postalCodes  String[]  @default([]) // envío: CP o rangos "3500-3509"
  localities   String[]  @default([])
  active       Boolean   @default(true)
  archivedAt   DateTime?
  sort         Int       @default(0)
  orders       Order[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Promociones automáticas (sin código) y cupones (con código).
model Promotion {
  id             String          @id @default(cuid())
  name           String
  code           String?         @unique
  kind           String // porcentaje | monto | envio_gratis | nxm | regalo
  value          Int             @default(0)
  description    String?
  buyQty         Int? // nxm: llevá X…
  payQty         Int? // …pagá Y
  giftMode       String? // regalo: variante | decant_del_producto
  giftVariant    ProductVariant? @relation("PromotionGift", fields: [giftVariantId], references: [id], onDelete: SetNull)
  giftVariantId  String?
  giftSizeMl     Float? // decant_del_producto: tamaño del decant de regalo (ej. 5)
  productIds     String[]        @default([]) // aplica solo a estos productos (vacío = todos)
  onePerCustomer Boolean         @default(false)
  showBanner     Boolean         @default(false)
  bannerText     String?
  showAsSale     Boolean         @default(false) // precio tachado en la tienda (solo % automáticas)
  posEnabled     Boolean         @default(false) // se puede aplicar en el punto de venta
  archivedAt     DateTime?
  minSubtotal    Int?
  startsAt       DateTime?
  endsAt         DateTime?
  maxUses        Int?
  usedCount      Int             @default(0)
  brand          Brand?          @relation(fields: [brandId], references: [id], onDelete: SetNull)
  brandId        String?
  origin         String?
  active         Boolean         @default(true)
  orders         Order[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([active, startsAt, endsAt])
}

// Listas de precios (mayorista, revendedores): regla general + precios puntuales por presentación.
model PriceList {
  id         String          @id @default(cuid())
  name       String          @unique
  rule       String // descuento (sobre el precio de venta) | recargo_costo (sobre el costo)
  pct        Float
  active     Boolean         @default(true)
  archivedAt DateTime?
  notes      String?
  items      PriceListItem[]
  customers  Customer[]
  orders     Order[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

model PriceListItem {
  id          String         @id @default(cuid())
  priceList   PriceList      @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  priceListId String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId   String
  price       Int

  @@unique([priceListId, variantId])
}

model ProductImage {
  id        String          @id @default(cuid())
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String
  publicId  String?
  width     Int?
  height    Int?
  alt       String?
  sort      Int             @default(0)
  kind      String          @default("image") // image | video
  // Foto de una presentación puntual (ej. el decant); vacío = del producto en general
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantId String?
  createdAt DateTime        @default(now())

  @@index([productId, sort])
}

// Textos legales editables desde el panel (se publican en la tienda en /legales/[slug]).
model LegalPage {
  slug        String     @id
  title       String
  body        String
  published   Boolean    @default(false)
  updatedBy   AdminUser? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedAt   DateTime   @updatedAt
}

// Botón de arrepentimiento (Res. 424/2020): cada solicitud recibe un código de seguimiento.
model WithdrawalRequest {
  id          String     @id @default(cuid())
  code        String     @unique
  order       Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId     String?
  orderRef    String?
  fullName    String
  email       String
  phone       String?
  docNumber   String?
  message     String?
  status      String     @default("pendiente") // pendiente | en_proceso | resuelta | rechazada
  resolution  String?
  handledBy   AdminUser? @relation(fields: [handledById], references: [id], onDelete: SetNull)
  handledById String?
  handledAt   DateTime?
  createdAt   DateTime   @default(now())

  @@index([status, createdAt])
}

// Mails y avisos enviados (registro para ver qué se le avisó a cada cliente).
model Notification {
  id        String   @id @default(cuid())
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId   String?
  channel   String // email | whatsapp
  to        String
  template  String
  subject   String?
  status    String // enviado | error | omitido
  error     String?
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([createdAt])
}

// Configuración general (datos del local, destinatarios de alertas, etc.).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Pedidos de perfumes que no están en el catálogo (formulario "Perfumes a pedido" de la tienda).
model PerfumeRequest {
  id          String     @id @default(cuid())
  code        String     @unique
  fullName    String
  phone       String
  product     String?
  details     String?
  imageUrl    String?
  status      String     @default("nuevo") // nuevo | cotizado | encargado | cerrado | descartado
  adminNote   String?
  handledBy   AdminUser? @relation(fields: [handledById], references: [id], onDelete: SetNull)
  handledById String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([phone])
}
