// GENERADO: copia de sokoshop-admin/prisma/schema.prisma (npm run schema:sync).
// NO editar acá ni correr `prisma migrate` / `db push` desde la tienda.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

model Brand {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  origin      String
  logoUrl     String?
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([name(ops: raw("gin_trgm_ops"))], map: "brand_name_trgm_idx", type: Gin)
}

model Product {
  id               String           @id @default(cuid())
  slug             String           @unique
  brand            Brand            @relation(fields: [brandId], references: [id])
  brandId          String
  name             String
  gender           String?
  concentration    String?
  decantAvailable  Boolean          @default(false)
  notesStructure   String           @default("sin_datos")
  olfactiveFamily  String?
  descriptionShort String?
  descriptionLong  String?
  launchYear       Int?
  status           String           @default("borrador")
  variants         ProductVariant[]
  notes            ProductNote[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([brandId])
  @@index([status])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "product_name_trgm_idx", type: Gin)
  @@index([olfactiveFamily(ops: raw("gin_trgm_ops"))], map: "product_family_trgm_idx", type: Gin)
}

model ProductVariant {
  id             String          @id @default(cuid())
  product        Product         @relation(fields: [productId], references: [id])
  productId      String
  type           String
  sizeMl         Float?
  price          Int
  salePrice      Int?
  stock          Int?
  skuInternal    String?         @unique
  gtin           String?
  costInclTax    Int?
  marginPct      Float?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  orderItems     OrderItem[]
  stockMovements StockMovement[]

  @@index([productId])
}

model Note {
  id       String        @id @default(cuid())
  name     String        @unique
  products ProductNote[]

  @@index([name(ops: raw("gin_trgm_ops"))], map: "note_name_trgm_idx", type: Gin)
}

model ProductNote {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id])
  productId String
  note      Note    @relation(fields: [noteId], references: [id])
  noteId    String
  position  String
  order     Int     @default(0)

  @@unique([productId, noteId, position])
  @@index([noteId])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin")
  createdAt    DateTime @default(now())

  active             Boolean   @default(true)
  // Se incrementa al cambiar contraseña/rol/2FA o desactivar: invalida sesiones abiertas.
  sessionVersion     Int       @default(0)
  totpSecretEnc      String?
  totpEnabled        Boolean   @default(false)
  totpLastStep       Int?
  recoveryCodeHashes String[]  @default([])
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime?
  updatedAt          DateTime  @default(now()) @updatedAt

  auditLogs      AuditLog[]
  stockMovements StockMovement[]
}

model Order {
  id             String          @id @default(cuid())
  status         String          @default("pendiente")
  total          Int
  customerEmail  String?
  customerName   String?
  mpPreferenceId String?
  mpPaymentId    String?
  items          OrderItem[]
  stockMovements StockMovement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status, createdAt])
  @@index([mpPaymentId])
}

model OrderItem {
  id               String         @id @default(cuid())
  order            Order          @relation(fields: [orderId], references: [id])
  orderId          String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  productVariantId String
  productName      String
  variantLabel     String
  price            Int
  quantity         Int

  @@index([orderId])
  @@index([productVariantId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  success   Boolean
  reason    String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

model AuditLog {
  id         String     @id @default(cuid())
  actor      AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?
  actorEmail String?
  action     String
  entity     String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime   @default(now())

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

// Todo cambio de stock queda registrado. quantity con signo (+ingreso / -venta).
model StockMovement {
  id         String         @id @default(cuid())
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  variantId  String
  type       String // venta_online | venta_local | venta_mayorista | ajuste | ingreso | devolucion
  quantity   Int
  stockAfter Int?
  order      Order?         @relation(fields: [orderId], references: [id])
  orderId    String?
  reason     String?
  actor      AdminUser?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?
  createdAt  DateTime       @default(now())

  // Idempotencia: un pedido no genera dos veces el mismo movimiento para una variante.
  @@unique([orderId, variantId, type])
  @@index([variantId, createdAt])
  @@index([type, createdAt])
}

// Redirecciones 301/410 que aplica la tienda (migración desde TiendaNegocio, cambios de slug).
model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String?
  statusCode Int      @default(301)
  active     Boolean  @default(true)
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
