datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Brand {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  origin      String
  logoUrl     String?
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id               String           @id @default(cuid())
  slug             String           @unique
  brand            Brand            @relation(fields: [brandId], references: [id])
  brandId          String
  name             String
  gender           String?
  concentration    String?
  decantAvailable  Boolean          @default(false)
  notesStructure   String           @default("sin_datos")
  olfactiveFamily  String?
  descriptionShort String?
  descriptionLong  String?
  launchYear       Int?
  status           String           @default("borrador")
  variants         ProductVariant[]
  notes            ProductNote[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model ProductVariant {
  id          String   @id @default(cuid())
  product     Product  @relation(fields: [productId], references: [id])
  productId   String
  type        String
  sizeMl      Float?
  price       Int
  salePrice   Int?
  stock       Int?
  skuInternal String?  @unique
  gtin        String?
  costInclTax Int?
  marginPct   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Note {
  id       String        @id @default(cuid())
  name     String        @unique
  products ProductNote[]
}

model ProductNote {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id])
  productId String
  note      Note    @relation(fields: [noteId], references: [id])
  noteId    String
  position  String
  order     Int     @default(0)

  @@unique([productId, noteId, position])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}
